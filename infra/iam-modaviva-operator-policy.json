{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowModavivaServices",
      "Effect": "Allow",
      "Action": [
        "ecs:*",
        "ecr:*",
        "elasticloadbalancing:*",
        "autoscaling:*",
        "ec2:Describe*",
        "ec2:Get*",
        "rds:Describe*",
        "rds:ListTagsForResource",
        "s3:*",
        "lambda:*",
        "events:*",
        "athena:*",
        "glue:*",
        "cloudwatch:*",
        "logs:*",
        "sns:*",
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "ssm:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowPassOnlyModavivaRoles",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::436847501474:role/modaviva-*",
        "arn:aws:iam::436847501474:role/ecsTaskExecutionRole"
      ]
    }
  ]
}